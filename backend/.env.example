DATABASE_URL=sqlite:///./ceo_ai.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:8000
APP_ENV=development
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

RESEND_API_KEY=
EMAIL_FROM=CEO.ai <onboarding@resend.dev>
APP_BASE_URL=http://localhost:3003
PASSWORD_RESET_MINUTES=60

SENTRY_DSN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=

VOICE_PROVIDER=sarvam
VOICE_LANGUAGE=en-IN
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v2
ELEVENLABS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# --- LLM providers (all free tiers, tried in order) --------------------
# Set LLM_LOCAL_ONLY=true to use Ollama exclusively. Free hosted tiers
# generally train on your prompts, so keep sensitive data local.
#
# Ollama    local, unlimited, private          ollama.com
# Groq      ~30 req/min, fastest               console.groq.com
# Gemini    ~15 req/min, 1500/day, 1M context  aistudio.google.com
# Cerebras  1M tokens/day                      cloud.cerebras.ai
# NVIDIA    hosted eval endpoints              build.nvidia.com
# OpenRouter ~30 free models, one key          openrouter.ai
#
# None of these require a credit card.
LLM_LOCAL_ONLY=false
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CRON_SECRET=random-secret-for-now-cron
